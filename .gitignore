# ambiente
.venv/
__pycache__/
*.pyc
# dados oficiais (baixe com `make dados-do-zero`; ~250 GB)
dados/*
!dados/listas/
dados/listas/*
!dados/listas/*.txt
dados/listas/sp_tmp/
# intermediários grandes (regeneráveis)
analise/brutos/
analise/*.parquet
grafico/web/dados.json
grafico/web/logs.json
grafico/web/relatorio.pdf
!dados/listas/MANIFESTO.csv

# termos pessoais bloqueados na publicação
scripts/.privado.txt

# resultados gigantes (regerados por analise/relatorio_dados.py) e backups locais
grafico/web/relatorio_dados.json
analise/historico_v1_log_duplicado/
grafico/web/relatorio_v1_backup.html

# documentação oficial do TSE (leve; guardada junto do projeto)
!dados/brutos/
dados/brutos/*
!dados/brutos/doc/
dados/brutos/doc/*.zip

# revisão R1: cópias de repositórios de terceiros e do próprio projeto ficam só locais (há manifesto com SHA-256 no relatório)
revisoes/*/original/fontes/
!dados/listas/MANIFESTO_hash_oficial.csv
