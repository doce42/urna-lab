{
  "hosting": {
    "public": "grafico/relatorio-app/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {"source": "**/*.@(js|css|woff2|svg|png|webp)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
      {"source": "**/*.json", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]}
    ]
  }
}
